# OmniRouter Server Configuration
PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# Master Gateway Auth Key (Optional - if unset, gateway auth is managed via Dashboard/DB)
GATEWAY_KEY=

# AES-256 Secret Key for encrypting provider keys and OAuth tokens (at least 32 characters)
ENCRYPTION_KEY=omnirouter-default-secret-key-32bytes!

# Local SQLite Database Path
DATABASE_PATH=data/omnirouter.db

# Optional Provider API Keys (Can also be added dynamically via the Dashboard UI)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

OLLAMA_BASE_URL=http://127.0.0.1:11434
