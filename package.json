{
  "name": "omnirouter",
  "version": "0.1.0",
  "description": "Free, local-first AI API gateway for Windows",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build:server": "tsc",
    "build:frontend": "cd frontend && npm.cmd run build",
    "build": "tsc && npm run build:frontend",
    "start": "node dist/server.js",
    "gateway:start": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/daemon.ps1 start",
    "gateway:stop": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/daemon.ps1 stop",
    "gateway:status": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/daemon.ps1 status",
    "gateway:restart": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/daemon.ps1 restart",
    "gateway:tray": "powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File scripts/tray.ps1",
    "gateway:autostart": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/daemon.ps1 autostart",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "ai",
    "gateway",
    "openai",
    "fastify",
    "router"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/static": "^10.1.11",
    "@types/better-sqlite3": "^9.6.0",
    "better-sqlite3": "^13.2.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.2.1",
    "lucide-react": "^1.75.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
